# Copy this file to .env and fill in the keys issued for BUILD LLM Proxy.
# .env is git-ignored. Never commit real keys.
BUILD_OPENAI_KEY=
BUILD_ANTHROPIC_KEY=
BUILD_GOOGLE_KEY=

# Django. Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
